@{
    ViewData["Title"] = "Kategori Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold py-3 mb-0"><span class="text-muted fw-light">Sistem Yönetimi /</span> Kategoriler</h4>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
        <i class="bx bx-plus me-1"></i> Yeni Kategori Ekle
    </button>
</div>

<div class="card">
    <div class="table-responsive text-nowrap">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Kategori Adı</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody id="categoryTableBody">
                <tr><td colspan="3" class="text-center py-4">Kategoriler yükleniyor...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalCenterTitle">Yeni Kategori Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col mb-3">
                        <label for="newCategoryName" class="form-label">Kategori Adı</label>
                        <input type="text" id="newCategoryName" class="form-control" placeholder="Örn: Mobil Programlama" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary" id="btnSaveCategory">Kaydet</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        var token = localStorage.getItem("token");
        if (!token) { window.location.href = "/Auth/Login"; return; }

        kategorileriGetir();

        function kategorileriGetir() {
            $.ajax({
                url: "https://localhost:7152/api/Categories",
                type: "GET",
                success: function (data) {
                    var html = "";
                    if(data.length === 0) {
                        html = '<tr><td colspan="3" class="text-center text-muted">Henüz kategori bulunmuyor.</td></tr>';
                    } else {
                        $.each(data, function (index, item) {
                            html += `
                                <tr>
                                    <td><strong>#${item.id}</strong></td>
                                    <td>${item.name}</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-danger" onclick="kategoriSil(${item.id})"><i class="bx bx-trash me-1"></i> Sil</button>
                                    </td>
                                </tr>
                            `;
                        });
                    }
                    $("#categoryTableBody").html(html);
                },
                error: function () {
                    $("#categoryTableBody").html('<tr><td colspan="3" class="text-center text-danger">Kategoriler yüklenirken hata oluştu.</td></tr>');
                }
            });
        }

        $("#btnSaveCategory").click(function () {
            var catName = $("#newCategoryName").val().trim();
            if (catName === "") { alert("Lütfen bir kategori adı yazın!"); return; }

            $.ajax({
                url: "https://localhost:7152/api/Categories",
                type: "POST",
                contentType: "application/json",
                headers: { "Authorization": "Bearer " + token },
                data: JSON.stringify({ Name: catName }),
                success: function () {
                    $("#addCategoryModal").modal('hide'); 
                    $("#newCategoryName").val(""); 
                    kategorileriGetir(); 
                },
                error: function (xhr) {
                    alert("Kategori eklenemedi. Yetkiniz olmayabilir.");
                }
            });
        });

        window.kategoriSil = function (id) {
            if (confirm("Bu kategoriyi silmek istediğinize emin misiniz?")) {
                $.ajax({
                    url: "https://localhost:7152/api/Categories/" + id,
                    type: "DELETE",
                    headers: { "Authorization": "Bearer " + token },
                    success: function () {
                        kategorileriGetir(); 
                    },
                    error: function () {
                        alert("Silme işlemi başarısız oldu. Bu kategoriye ait sorular olabilir.");
                    }
                });
            }
        };
    });
</script>